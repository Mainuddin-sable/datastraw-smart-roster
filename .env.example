# Frontend: browser-visible base URL for the FastAPI service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend: use the Supabase pooler URI (PostgreSQL) in deployed environments.
# Replace the placeholders locally; never commit a populated .env file.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
