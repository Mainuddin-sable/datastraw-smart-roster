# Frontend: browser-visible base URL for the FastAPI service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend: SQLite is the application database.
# This relative path is for local development when starting the API from backend/.
# Hosted deployments should use an absolute path on the backend host's persistent disk,
# for example: sqlite:////var/data/smart_roster.db
DATABASE_URL=sqlite:///./smart_roster.db
# Set this to the exact deployed frontend origin when hosting the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production mode requires HTTP Basic credentials and disables public API docs.
APP_ENV=development
# Server-only HTTP Basic credentials. Supply unique values in each environment.
# In production, the API refuses to start unless both are configured.
DEMO_AUTH_USERNAME=
DEMO_AUTH_PASSWORD=
